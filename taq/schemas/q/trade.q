trade: ([]
  time: `timespan$();
  ex: `char$();
  sym: `symbol$();
  cond: `symbol$();
  size: `real$();
  price: `real$();
  stop: `symbol$();
  corr: `short$();
  seq: `int$();
  tradeId: `long$();
  source: `char$();
  tradeReportingFacility: `symbol$();
  participantTimestamp: `timespan$();
  tradeReportingFacilityTRFTimestamp: `timespan$();
  tradeThroughExemptIndicator: `boolean$()
  )
